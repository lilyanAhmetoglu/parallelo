{
  "name": "parallelo-session",
  "displayName": "Parallelo Session",
  "description": "Binds the active terminal to its git worktree. Switch terminals, and the changes and files views follow.",
  "version": "1.1.0",
  "publisher": "LilyanALDIMASHKI",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "worktree",
    "git",
    "agent",
    "claude code",
    "codex",
    "copilot",
    "parallel"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeSessions",
          "title": "Parallelo Session",
          "icon": "resources/parallelo.svg"
        }
      ]
    },
    "views": {
      "worktreeSessions": [
        {
          "id": "worktreeSessions.changes",
          "name": "Changes",
          "icon": "resources/parallelo.svg"
        },
        {
          "id": "worktreeSessions.files",
          "name": "Files",
          "icon": "resources/parallelo.svg",
          "visibility": "collapsed"
        },
        {
          "id": "worktreeSessions.sessions",
          "name": "Sessions",
          "icon": "resources/parallelo.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeSessions.changes",
        "contents": "Open a terminal inside a git worktree to see its changes here.\n\n[Start a worktree session](command:parallelo.newSession)"
      },
      {
        "view": "worktreeSessions.sessions",
        "contents": "No terminals are running in a git worktree yet.\n\n[Start a worktree session](command:parallelo.newSession)\n[Open a terminal in every worktree](command:parallelo.openAllWorktrees)"
      }
    ],
    "commands": [
      {
        "command": "parallelo.newSession",
        "title": "Start Worktree Session",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.newRoom",
        "title": "Start Brainstorming Room",
        "icon": "$(comment-discussion)",
        "category": "Parallelo"
      },
      {
        "command": "parallelo.sendRoomBrief",
        "title": "Send Brainstorming Room Brief",
        "category": "Parallelo"
      },
      {
        "command": "parallelo.showRoomTranscript",
        "title": "Show Brainstorming Room Transcript",
        "category": "Parallelo"
      },
      {
        "command": "parallelo.openAllWorktrees",
        "title": "Open a Terminal in Every Worktree",
        "category": "Parallelo Session",
        "icon": "$(terminal)"
      },
      {
        "command": "parallelo.refresh",
        "title": "Refresh",
        "category": "Parallelo Session",
        "icon": "$(refresh)"
      },
      {
        "command": "parallelo.focusTerminal",
        "title": "Focus Session Terminal",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.openChange",
        "title": "Open Change",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.discardChange",
        "title": "Discard Changes",
        "category": "Parallelo Session",
        "icon": "$(discard)"
      },
      {
        "command": "parallelo.unstageChange",
        "title": "Unstage Changes",
        "category": "Parallelo Session",
        "icon": "$(remove)"
      },
      {
        "command": "parallelo.stageChange",
        "title": "Stage Changes",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.stageGroup",
        "title": "Stage All in Group",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.unstageGroup",
        "title": "Unstage All in Group",
        "category": "Parallelo Session",
        "icon": "$(remove)"
      },
      {
        "command": "parallelo.discardGroup",
        "title": "Discard All in Group",
        "category": "Parallelo Session",
        "icon": "$(discard)"
      },
      {
        "command": "parallelo.resetBaseline",
        "title": "Reset Session Baseline to Now",
        "category": "Parallelo Session",
        "icon": "$(history)"
      },
      {
        "command": "parallelo.stageAll",
        "title": "Stage All Changes in Session",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.revealInScm",
        "title": "Reveal Session in Source Control",
        "category": "Parallelo Session",
        "icon": "$(source-control)"
      },
      {
        "command": "parallelo.removeWorktree",
        "title": "Delete Worktree (Discards Uncommitted Changes)",
        "category": "Parallelo Session",
        "icon": "$(trash)"
      },
      {
        "command": "parallelo.renameSession",
        "title": "Rename Session",
        "category": "Parallelo Session",
        "icon": "$(edit)"
      },
      {
        "command": "parallelo.setSessionColor",
        "title": "Set Session Color",
        "category": "Parallelo Session",
        "icon": "$(symbol-color)"
      },
      {
        "command": "parallelo.setSessionIcon",
        "title": "Set Session Icon",
        "category": "Parallelo Session",
        "icon": "$(symbol-event)"
      },
      {
        "command": "parallelo.resetSessionStyle",
        "title": "Reset Session Appearance",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.customizeSession",
        "title": "Customize Session",
        "category": "Parallelo Session",
        "icon": "$(paintcan)"
      },
      {
        "command": "parallelo.closeSession",
        "title": "Close Session (Keeps the Worktree and Changes)",
        "category": "Parallelo Session",
        "icon": "$(close)"
      },
      {
        "command": "parallelo.pinSession",
        "title": "Pin Session to Top",
        "category": "Parallelo Session",
        "icon": "$(pinned)"
      },
      {
        "command": "parallelo.unpinSession",
        "title": "Unpin Session",
        "category": "Parallelo Session",
        "icon": "$(pin)"
      },
      {
        "command": "parallelo.quickSwitch",
        "title": "Switch Session",
        "category": "Parallelo Session",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "parallelo.showLog",
        "title": "Show Log",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.findInFiles",
        "title": "Find in Files",
        "category": "Parallelo Session",
        "icon": "$(search)"
      },
      {
        "command": "parallelo.findInChanges",
        "title": "Find in Changes",
        "category": "Parallelo Session",
        "icon": "$(search)"
      },
      {
        "command": "parallelo.setUpStatusHooks",
        "title": "Set Up Status Hooks",
        "category": "Parallelo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "parallelo.newSession",
          "when": "view == worktreeSessions.sessions",
          "group": "navigation@1"
        },
        {
          "command": "parallelo.openAllWorktrees",
          "when": "view == worktreeSessions.sessions",
          "group": "navigation@2"
        },
        {
          "command": "parallelo.refresh",
          "when": "view =~ /^worktreeSessions\\./",
          "group": "navigation@3"
        },
        {
          "command": "parallelo.stageAll",
          "when": "view == worktreeSessions.changes",
          "group": "navigation@1"
        },
        {
          "command": "parallelo.revealInScm",
          "when": "view == worktreeSessions.changes",
          "group": "navigation@3"
        },
        {
          "command": "parallelo.findInFiles",
          "when": "view == worktreeSessions.files",
          "group": "navigation@0"
        },
        {
          "command": "parallelo.findInChanges",
          "when": "view == worktreeSessions.changes",
          "group": "navigation@0"
        },
        {
          "command": "parallelo.setUpStatusHooks",
          "when": "view == worktreeSessions.sessions",
          "group": "9_config"
        }
      ],
      "view/item/context": [
        {
          "command": "parallelo.customizeSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "inline@1"
        },
        {
          "command": "parallelo.resetSessionStyle",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@3"
        },
        {
          "command": "parallelo.setSessionIcon",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@2"
        },
        {
          "command": "parallelo.setSessionColor",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@1"
        },
        {
          "command": "parallelo.renameSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@0"
        },
        {
          "command": "parallelo.removeWorktree",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^worktreeSession(Pinned)?$/",
          "group": "inline@2"
        },
        {
          "command": "parallelo.closeSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^[sS]ession(Pinned)?$/",
          "group": "inline@2"
        },
        {
          "command": "parallelo.pinSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession$/",
          "group": "1a_pin@1"
        },
        {
          "command": "parallelo.unpinSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]essionPinned$/",
          "group": "1a_pin@1"
        },
        {
          "command": "parallelo.closeSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "2_session@1"
        },
        {
          "command": "parallelo.removeWorktree",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^worktreeSession(Pinned)?$/",
          "group": "9_danger@1"
        },
        {
          "command": "parallelo.discardChange",
          "when": "view == worktreeSessions.changes && viewItem == change",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardChange",
          "when": "view == worktreeSessions.changes && viewItem == untrackedChange",
          "group": "inline@1"
        },
        {
          "command": "parallelo.unstageChange",
          "when": "view == worktreeSessions.changes && viewItem == stagedChange",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardChange",
          "when": "view == worktreeSessions.changes && viewItem =~ /^(untracked)?[cC]hange$/",
          "group": "1_change@1"
        },
        {
          "command": "parallelo.unstageChange",
          "when": "view == worktreeSessions.changes && viewItem == stagedChange",
          "group": "1_change@1"
        },
        {
          "command": "parallelo.resetBaseline",
          "when": "view == worktreeSessions.changes && viewItem == \"commits\"",
          "group": "inline@1"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem == change",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem == untrackedChange",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem == mergeChange",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem =~ /^(untracked|merge)?[cC]hange$/",
          "group": "1_change@2"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "1_group@1"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "1_group@2"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "1_group@1"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "1_group@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == mergeGroup",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == mergeGroup",
          "group": "1_group@2"
        },
        {
          "command": "parallelo.unstageGroup",
          "when": "view == worktreeSessions.changes && viewItem == stagedGroup",
          "group": "inline@1"
        },
        {
          "command": "parallelo.unstageGroup",
          "when": "view == worktreeSessions.changes && viewItem == stagedGroup",
          "group": "1_group@1"
        }
      ],
      "commandPalette": [
        {
          "command": "parallelo.openChange",
          "when": "false"
        },
        {
          "command": "parallelo.discardChange",
          "when": "false"
        },
        {
          "command": "parallelo.unstageChange",
          "when": "false"
        },
        {
          "command": "parallelo.focusTerminal",
          "when": "false"
        },
        {
          "command": "parallelo.stageChange",
          "when": "false"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "false"
        },
        {
          "command": "parallelo.unstageGroup",
          "when": "false"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Parallelo Session",
      "properties": {
        "parallelo.agents": {
          "type": "array",
          "default": [
            {
              "label": "Claude Code",
              "command": "claude",
              "modelFlag": "--model",
              "models": [
                {
                  "label": "Opus 5",
                  "value": "claude-opus-5"
                },
                {
                  "label": "Sonnet 5",
                  "value": "claude-sonnet-5"
                },
                {
                  "label": "Haiku 4.5",
                  "value": "claude-haiku-4-5"
                },
                {
                  "label": "Default",
                  "value": ""
                }
              ],
              "roomArgs": "--append-system-prompt-file ${roomDir}/${seat}.md --strict-mcp-config --mcp-config ${roomDir}/mcp.json --allowedTools \"Read,Glob,Grep,mcp__roundtable__post,mcp__roundtable__wait_for_message,mcp__roundtable__read_room,mcp__roundtable__room_status,mcp__roundtable__write_spec,mcp__roundtable__close_room\" --disallowedTools \"Write,Edit,MultiEdit,NotebookEdit,Bash,BashOutput,KillShell,Task,SlashCommand,WebFetch,WebSearch\"",
              "leadRoomArgs": "--append-system-prompt-file ${roomDir}/${seat}.md --strict-mcp-config --mcp-config ${roomDir}/mcp.json --allowedTools \"Read,Glob,Grep,Bash(git:*),mcp__roundtable__post,mcp__roundtable__wait_for_message,mcp__roundtable__read_room,mcp__roundtable__room_status,mcp__roundtable__write_spec,mcp__roundtable__close_room\" --disallowedTools \"Write,Edit,MultiEdit,NotebookEdit,Task,SlashCommand,WebFetch,WebSearch\""
            },
            {
              "label": "Codex",
              "command": "codex",
              "modelFlag": "--model",
              "models": []
            },
            {
              "label": "GitHub Copilot",
              "command": "copilot",
              "modelFlag": "--model",
              "models": []
            },
            {
              "label": "Shell only",
              "command": ""
            }
          ],
          "description": "Agents offered when starting a session or a brainstorming room. An empty command opens the terminal without launching anything. Give an agent two or more models and you are asked which one to run; the choice is passed with modelFlag (default --model) and recorded in the room transcript.",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "modelFlag": {
                "type": "string",
                "default": "--model",
                "description": "How this agent takes a model on its command line."
              },
              "models": {
                "type": "array",
                "description": "Models to offer for this agent. Fewer than two and nothing is asked. An empty value means the agent's own default.",
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "roomArgs": {
                "type": "string",
                "markdownDescription": "Flags this agent needs in a brainstorming room, and nowhere else. `${roomDir}`, `${room}` and `${seat}` are substituted.\n\nTwo jobs. **Point the agent at the room** \u2014 its MCP config, so it can reach the other seat, and its brief through the system prompt, because typed input is eaten by an agent\u2019s startup dialog and a seat that never read its brief looks exactly like one waiting properly. **Keep the room a planning room** \u2014 an agent holding a file tool will implement rather than plan, so allow reading and the room\u2019s own tools and deny writing and the shell; the spec is produced through the server\u2019s `write_spec` tool.\n\nClaude Code ships with a working value. An agent with no roomArgs cannot be seated, because a seat that cannot reach the server is a room that silently does nothing."
              },
              "leadRoomArgs": {
                "type": "string",
                "description": "Room flags for the lead seat only. Falls back to roomArgs. The lead is the seat that produces something, so it is the one given git."
              }
            }
          }
        },
        "parallelo.worktreePath": {
          "type": "string",
          "default": ".worktrees",
          "description": "Directory for new worktrees, relative to the repository root."
        },
        "parallelo.branchPrefix": {
          "type": "string",
          "default": "session/",
          "description": "Prefix applied to branches created for new sessions."
        },
        "parallelo.autoOpenRepository": {
          "type": "boolean",
          "default": true,
          "description": "Register a worktree with the git extension when a terminal enters it, so its changes appear without adding the folder to the workspace."
        },
        "parallelo.setupCommand": {
          "type": "string",
          "default": "",
          "description": "Command run once in a new worktree before the agent starts, instead of the install parallelo.installDependencies would have chosen. Useful in a monorepo, for example: bun install --filter web."
        },
        "parallelo.copyFiles": {
          "type": "array",
          "default": [
            ".env",
            ".env.local"
          ],
          "description": "Files always copied from the base checkout into a new worktree, named one by one. Copied even when parallelo.copyIgnoredFiles is off, when parallelo.copyExclude would skip them, or when git is not ignoring them at all.",
          "items": {
            "type": "string"
          }
        },
        "parallelo.copyExclude": {
          "type": "array",
          "default": [
            "node_modules",
            ".git",
            ".worktrees",
            ".roundtable",
            "dist",
            "build",
            "out",
            "target",
            ".next",
            ".nuxt",
            ".svelte-kit",
            ".turbo",
            ".cache",
            ".parcel-cache",
            ".pytest_cache",
            "__pycache__",
            ".venv",
            "venv",
            "coverage",
            ".DS_Store",
            "*.log"
          ],
          "description": "Names skipped when copying ignored files into a new worktree, matched against each part of the path so build output nested in a monorepo is skipped too. Dependencies and build output are installed or rebuilt, not carried. Supports * and ?.",
          "items": {
            "type": "string"
          }
        },
        "parallelo.installDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Run the install a new worktree needs before the agent starts, chosen from the base checkout's packageManager field or lockfile (bun, pnpm, yarn, npm). node_modules is ignored by git, so a worktree never comes with one. Not used when parallelo.setupCommand is set."
        },
        "parallelo.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active session's branch and change count in the status bar."
        },
        "parallelo.followProcessCwd": {
          "type": "boolean",
          "default": true,
          "description": "Resolve the worktree from the processes running in the terminal, not just the shell. Needed when an agent creates its own worktree and moves itself into it, leaving the shell behind. No effect on Windows."
        },
        "parallelo.autoSessionColors": {
          "type": "boolean",
          "default": true,
          "description": "Give each session a distinct colour automatically. A colour you set yourself is never overwritten."
        },
        "parallelo.stashGuard": {
          "type": "boolean",
          "default": true,
          "description": "Warn once per repository when the stash is used while more than one session is live. The stash is shared across every worktree, so one session can pop what another stashed."
        },
        "parallelo.conflictRadar": {
          "type": "boolean",
          "default": true,
          "description": "Mark sessions that have edited the same file as another session of the same repository, before the merge does."
        },
        "parallelo.showMainCheckout": {
          "type": "boolean",
          "default": true,
          "description": "List a terminal in the main checkout as a session. Turn this off to see only worktree sessions -- the main checkout always has a row and can never be removed, because git worktree remove refuses the main working tree."
        },
        "parallelo.openWorktreeTerminals": {
          "type": "boolean",
          "default": true,
          "description": "Open a terminal in every worktree of the repository when the window starts, so each one appears in the Sessions list without being visited first. Worktrees that already have a terminal are left alone."
        },
        "parallelo.sessionBaseline": {
          "type": "boolean",
          "default": true,
          "description": "List the commits each worktree session has made, and count them in the conflict radar."
        },
        "parallelo.alwaysShowFind": {
          "type": "boolean",
          "default": true,
          "description": "Open the find box automatically when the Changes or Files view appears, so it is always there. Opening it also puts the cursor in it. Turn this off to open it with the magnifier or Cmd+F instead."
        },
        "parallelo.roundtable.command": {
          "type": "string",
          "default": "roundtable",
          "description": "The roundtable MCP server executable that brainstorming rooms run. Install it with: bun add -g roundtable-mcp"
        },
        "parallelo.roundtable.budget": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "How many turns the lead agent gets in a brainstorming room. This is what ends the discussion: two agents left alone keep refining a plan indefinitely."
        },
        "parallelo.roundtable.agentArgs": {
          "type": "string",
          "default": "",
          "markdownDescription": "Overrides every agent\u2019s `roomArgs` in a brainstorming room. Leave empty \u2014 the default \u2014 and each agent uses its own, which is where these flags belong, since they are that agent\u2019s syntax. Set this only to force one command line on both seats. `${roomDir}`, `${room}` and `${seat}` are substituted."
        },
        "parallelo.sessionStatus": {
          "type": "boolean",
          "default": true,
          "description": "Mark a session when its agent asks you something or finishes a turn. The agent says so itself, through its own notification hooks -- run \"Parallelo: Set Up Status Hooks\" to wire them."
        },
        "parallelo.copyIgnoredFiles": {
          "type": "boolean",
          "default": true,
          "description": "Copy the files .gitignore covers -- .env and the like -- from the base checkout into a new worktree. A worktree checks out tracked files only, so it never comes with them. Directories listed in parallelo.copyExclude are skipped."
        }
      }
    }
  },
