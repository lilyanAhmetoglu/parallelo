{
  "name": "parallelo-session",
  "displayName": "Parallelo Session",
  "description": "Binds the active terminal to its git worktree. Switch terminals, and the changes and files views follow.",
  "version": "1.0.5",
  "publisher": "LilyanALDIMASHKI",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "worktree",
    "git",
    "agent",
    "claude code",
    "codex",
    "copilot",
    "parallel"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeSessions",
          "title": "Parallelo Session",
          "icon": "resources/parallelo.svg"
        }
      ]
    },
    "views": {
      "worktreeSessions": [
        {
          "id": "worktreeSessions.changes",
          "name": "Changes",
          "icon": "resources/parallelo.svg"
        },
        {
          "id": "worktreeSessions.files",
          "name": "Files",
          "icon": "resources/parallelo.svg",
          "visibility": "collapsed"
        },
        {
          "id": "worktreeSessions.sessions",
          "name": "Sessions",
          "icon": "resources/parallelo.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeSessions.changes",
        "contents": "Open a terminal inside a git worktree to see its changes here.\n\n[Start a worktree session](command:parallelo.newSession)"
      },
      {
        "view": "worktreeSessions.sessions",
        "contents": "No terminals are running in a git worktree yet.\n\n[Start a worktree session](command:parallelo.newSession)\n[Open a terminal in every worktree](command:parallelo.openAllWorktrees)"
      }
    ],
    "commands": [
      {
        "command": "parallelo.newSession",
        "title": "Start Worktree Session",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.openAllWorktrees",
        "title": "Open a Terminal in Every Worktree",
        "category": "Parallelo Session",
        "icon": "$(terminal)"
      },
      {
        "command": "parallelo.refresh",
        "title": "Refresh",
        "category": "Parallelo Session",
        "icon": "$(refresh)"
      },
      {
        "command": "parallelo.focusTerminal",
        "title": "Focus Session Terminal",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.openChange",
        "title": "Open Change",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.discardChange",
        "title": "Discard Changes",
        "category": "Parallelo Session",
        "icon": "$(discard)"
      },
      {
        "command": "parallelo.unstageChange",
        "title": "Unstage Changes",
        "category": "Parallelo Session",
        "icon": "$(remove)"
      },
      {
        "command": "parallelo.stageChange",
        "title": "Stage Changes",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.stageGroup",
        "title": "Stage All in Group",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.unstageGroup",
        "title": "Unstage All in Group",
        "category": "Parallelo Session",
        "icon": "$(remove)"
      },
      {
        "command": "parallelo.discardGroup",
        "title": "Discard All in Group",
        "category": "Parallelo Session",
        "icon": "$(discard)"
      },
      {
        "command": "parallelo.resetBaseline",
        "title": "Reset Session Baseline to Now",
        "category": "Parallelo Session",
        "icon": "$(history)"
      },
      {
        "command": "parallelo.stageAll",
        "title": "Stage All Changes in Session",
        "category": "Parallelo Session",
        "icon": "$(add)"
      },
      {
        "command": "parallelo.revealInScm",
        "title": "Reveal Session in Source Control",
        "category": "Parallelo Session",
        "icon": "$(source-control)"
      },
      {
        "command": "parallelo.removeWorktree",
        "title": "Delete Worktree (Discards Uncommitted Changes)",
        "category": "Parallelo Session",
        "icon": "$(trash)"
      },
      {
        "command": "parallelo.renameSession",
        "title": "Rename Session",
        "category": "Parallelo Session",
        "icon": "$(edit)"
      },
      {
        "command": "parallelo.setSessionColor",
        "title": "Set Session Color",
        "category": "Parallelo Session",
        "icon": "$(symbol-color)"
      },
      {
        "command": "parallelo.setSessionIcon",
        "title": "Set Session Icon",
        "category": "Parallelo Session",
        "icon": "$(symbol-event)"
      },
      {
        "command": "parallelo.resetSessionStyle",
        "title": "Reset Session Appearance",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.customizeSession",
        "title": "Customize Session",
        "category": "Parallelo Session",
        "icon": "$(paintcan)"
      },
      {
        "command": "parallelo.closeSession",
        "title": "Close Session (Keeps the Worktree and Changes)",
        "category": "Parallelo Session",
        "icon": "$(close)"
      },
      {
        "command": "parallelo.pinSession",
        "title": "Pin Session to Top",
        "category": "Parallelo Session",
        "icon": "$(pinned)"
      },
      {
        "command": "parallelo.unpinSession",
        "title": "Unpin Session",
        "category": "Parallelo Session",
        "icon": "$(pin)"
      },
      {
        "command": "parallelo.quickSwitch",
        "title": "Switch Session",
        "category": "Parallelo Session",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "parallelo.showLog",
        "title": "Show Log",
        "category": "Parallelo Session"
      },
      {
        "command": "parallelo.findInFiles",
        "title": "Find in Files",
        "category": "Parallelo Session",
        "icon": "$(search)"
      },
      {
        "command": "parallelo.findInChanges",
        "title": "Find in Changes",
        "category": "Parallelo Session",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "parallelo.newSession",
          "when": "view == worktreeSessions.sessions",
          "group": "navigation@1"
        },
        {
          "command": "parallelo.openAllWorktrees",
          "when": "view == worktreeSessions.sessions",
          "group": "navigation@2"
        },
        {
          "command": "parallelo.refresh",
          "when": "view =~ /^worktreeSessions\\./",
          "group": "navigation@3"
        },
        {
          "command": "parallelo.stageAll",
          "when": "view == worktreeSessions.changes",
          "group": "navigation@1"
        },
        {
          "command": "parallelo.revealInScm",
          "when": "view == worktreeSessions.changes",
          "group": "navigation@3"
        },
        {
          "command": "parallelo.findInFiles",
          "when": "view == worktreeSessions.files",
          "group": "navigation@0"
        },
        {
          "command": "parallelo.findInChanges",
          "when": "view == worktreeSessions.changes",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "parallelo.customizeSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "inline@1"
        },
        {
          "command": "parallelo.resetSessionStyle",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@3"
        },
        {
          "command": "parallelo.setSessionIcon",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@2"
        },
        {
          "command": "parallelo.setSessionColor",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@1"
        },
        {
          "command": "parallelo.renameSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "1_style@0"
        },
        {
          "command": "parallelo.removeWorktree",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^worktreeSession(Pinned)?$/",
          "group": "inline@2"
        },
        {
          "command": "parallelo.closeSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^[sS]ession(Pinned)?$/",
          "group": "inline@2"
        },
        {
          "command": "parallelo.pinSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession$/",
          "group": "1a_pin@1"
        },
        {
          "command": "parallelo.unpinSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]essionPinned$/",
          "group": "1a_pin@1"
        },
        {
          "command": "parallelo.closeSession",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^(worktree)?[sS]ession(Pinned)?$/",
          "group": "2_session@1"
        },
        {
          "command": "parallelo.removeWorktree",
          "when": "view == worktreeSessions.sessions && viewItem =~ /^worktreeSession(Pinned)?$/",
          "group": "9_danger@1"
        },
        {
          "command": "parallelo.discardChange",
          "when": "view == worktreeSessions.changes && viewItem == change",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardChange",
          "when": "view == worktreeSessions.changes && viewItem == untrackedChange",
          "group": "inline@1"
        },
        {
          "command": "parallelo.unstageChange",
          "when": "view == worktreeSessions.changes && viewItem == stagedChange",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardChange",
          "when": "view == worktreeSessions.changes && viewItem =~ /^(untracked)?[cC]hange$/",
          "group": "1_change@1"
        },
        {
          "command": "parallelo.unstageChange",
          "when": "view == worktreeSessions.changes && viewItem == stagedChange",
          "group": "1_change@1"
        },
        {
          "command": "parallelo.resetBaseline",
          "when": "view == worktreeSessions.changes && viewItem == \"commits\"",
          "group": "inline@1"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem == change",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem == untrackedChange",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem == mergeChange",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageChange",
          "when": "view == worktreeSessions.changes && viewItem =~ /^(untracked|merge)?[cC]hange$/",
          "group": "1_change@2"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "1_group@1"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == unstagedGroup",
          "group": "1_group@2"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "inline@1"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "1_group@1"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == untrackedGroup",
          "group": "1_group@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == mergeGroup",
          "group": "inline@2"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "view == worktreeSessions.changes && viewItem == mergeGroup",
          "group": "1_group@2"
        },
        {
          "command": "parallelo.unstageGroup",
          "when": "view == worktreeSessions.changes && viewItem == stagedGroup",
          "group": "inline@1"
        },
        {
          "command": "parallelo.unstageGroup",
          "when": "view == worktreeSessions.changes && viewItem == stagedGroup",
          "group": "1_group@1"
        }
      ],
      "commandPalette": [
        {
          "command": "parallelo.openChange",
          "when": "false"
        },
        {
          "command": "parallelo.discardChange",
          "when": "false"
        },
        {
          "command": "parallelo.unstageChange",
          "when": "false"
        },
        {
          "command": "parallelo.focusTerminal",
          "when": "false"
        },
        {
          "command": "parallelo.stageChange",
          "when": "false"
        },
        {
          "command": "parallelo.stageGroup",
          "when": "false"
        },
        {
          "command": "parallelo.unstageGroup",
          "when": "false"
        },
        {
          "command": "parallelo.discardGroup",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Parallelo Session",
      "properties": {
        "parallelo.agents": {
          "type": "array",
          "default": [
            {
              "label": "Claude Code",
              "command": "claude"
            },
            {
              "label": "Codex",
              "command": "codex"
            },
            {
              "label": "GitHub Copilot",
              "command": "copilot"
            },
            {
              "label": "Shell only",
              "command": ""
            }
          ],
          "description": "Agents offered when starting a worktree session. An empty command opens the terminal without launching anything.",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              }
            }
          }
        },
        "parallelo.worktreePath": {
          "type": "string",
          "default": ".worktrees",
          "description": "Directory for new worktrees, relative to the repository root."
        },
        "parallelo.branchPrefix": {
          "type": "string",
          "default": "session/",
          "description": "Prefix applied to branches created for new sessions."
        },
        "parallelo.autoOpenRepository": {
          "type": "boolean",
          "default": true,
          "description": "Register a worktree with the git extension when a terminal enters it, so its changes appear without adding the folder to the workspace."
        },
        "parallelo.setupCommand": {
          "type": "string",
          "default": "",
          "description": "Command run once in a new worktree before the agent starts. Useful in a monorepo, for example: bun install."
        },
        "parallelo.copyFiles": {
          "type": "array",
          "default": [
            ".env",
            ".env.local"
          ],
          "description": "Untracked files copied from the main checkout into each new worktree.",
          "items": {
            "type": "string"
          }
        },
        "parallelo.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active session's branch and change count in the status bar."
        },
        "parallelo.followProcessCwd": {
          "type": "boolean",
          "default": true,
          "description": "Resolve the worktree from the processes running in the terminal, not just the shell. Needed when an agent creates its own worktree and moves itself into it, leaving the shell behind. No effect on Windows."
        },
        "parallelo.autoSessionColors": {
          "type": "boolean",
          "default": true,
          "description": "Give each session a distinct colour automatically. A colour you set yourself is never overwritten."
        },
        "parallelo.stashGuard": {
          "type": "boolean",
          "default": true,
          "description": "Warn once per repository when the stash is used while more than one session is live. The stash is shared across every worktree, so one session can pop what another stashed."
        },
        "parallelo.conflictRadar": {
          "type": "boolean",
          "default": true,
          "description": "Mark sessions that have edited the same file as another session of the same repository, before the merge does."
        },
        "parallelo.showMainCheckout": {
          "type": "boolean",
          "default": true,
          "description": "List a terminal in the main checkout as a session. Turn this off to see only worktree sessions -- the main checkout always has a row and can never be removed, because git worktree remove refuses the main working tree."
        },
        "parallelo.openWorktreeTerminals": {
          "type": "boolean",
          "default": true,
          "description": "Open a terminal in every worktree of the repository when the window starts, so each one appears in the Sessions list without being visited first. Worktrees that already have a terminal are left alone."
        },
        "parallelo.sessionBaseline": {
          "type": "boolean",
          "default": true,
          "description": "List the commits each worktree session has made, and count them in the conflict radar."
        },
        "parallelo.alwaysShowFind": {
          "type": "boolean",
          "default": true,
          "description": "Open the find box automatically when the Changes or Files view appears, so it is always there. Opening it also puts the cursor in it. Turn this off to open it with the magnifier or Cmd+F instead."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lilyanAhmetoglu/parallelo.git"
  },
  "homepage": "https://github.com/lilyanAhmetoglu/parallelo#readme",
  "bugs": {
    "url": "https://github.com/lilyanAhmetoglu/parallelo/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
